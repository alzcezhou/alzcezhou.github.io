---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import TextureOverlay from "../components/TextureOverlay.astro";
import ProjectCard from "../components/ProjectCard.astro";

const projects = await getCollection("work");

// Landing card copy, in display order (independent of frontmatter `order`, which drives case study prev/next)
// eifu-marketing-site is hidden from the landing page (its case study page still builds)
const cardCopy = [
  {
    id: "ai-chat-interface",
    eyebrow: "CASE 01 / AI ASSISTANT · ENLABEL · 2026",
    title: "One AI assistant for every product in a labeling ecosystem",
    tags: ["2 DESIGN ROUNDS", "AI TOOLS", "COMPONENT SYSTEM"],
    resultNumber: "2 rounds",
    resultLabel: "from one-shot generator to reusable component",
  },
  {
    id: "skiplegal",
    eyebrow: "CASE 02 / SKIPLEGAL · CLIENT CAPSTONE · 2025",
    title: "Letting users decide how much AI touches their immigration forms",
    tags: ["CLIENT PROJECT", "AI TOOLS", "MULTI-STEP FORMS"],
    resultNumber: "+37%",
    resultLabel: "trust rating, test round 1 → 2",
  },
  {
    id: "haven",
    eyebrow: "CASE 03 / HAVEN · TUFTS PRODUCTHON · 2024",
    title: "Anonymous incident reporting students actually trust",
    tags: ["1ST PLACE", "MOBILE", "0 TO 1"],
    resultNumber: "1st",
    resultLabel: "place, Tufts Spring 2024 Producthon",
  },
];

const cards = cardCopy.map(({ id, ...copy }) => {
  const project = projects.find((p) => p.id === id);
  if (!project) throw new Error(`Landing card references missing work entry "${id}"`);
  return { ...copy, project };
});

const toolsRibbon = "/images/home%20page/my%20tools%20ribbon";
const dailyTools = [
  { src: `${toolsRibbon}/figma-icon.png`, alt: "Figma" },
  { src: `${toolsRibbon}/krita-icon.png`, alt: "Krita" },
  { src: `${toolsRibbon}/miro-icon.png`, alt: "Miro" },
  { src: `${toolsRibbon}/notion-icon.png`, alt: "Notion" },
  { src: `${toolsRibbon}/obsidian-icon.png`, alt: "Obsidian" },
  { src: `${toolsRibbon}/lottie-icon.png`, alt: "LottieFiles" },
  { src: `${toolsRibbon}/gsap-icon.png`, alt: "GSAP" },
  { src: `${toolsRibbon}/claude-ai-icon.png`, alt: "Claude" },
  { src: `${toolsRibbon}/claude-code-icon.png`, alt: "Claude Code" },
  { src: `${toolsRibbon}/lovable-ai-icon.png`, alt: "Lovable" },
] as const;
---

<BaseLayout title="Alice Zhou — Portfolio">

  <!-- Hero + Tagline: first viewport has hero filling space, band aligned to bottom; then scrolls normally -->
  <div class="min-h-svh flex flex-col">
    <!-- Flex column: spinner + name fill the space above, CTA row sits at the bottom so they never overlap -->
    <section class="min-h-[88vh] flex-1 flex flex-col gap-6 relative overflow-hidden bg-bg-light pt-24 px-6 pb-7">
      <TextureOverlay size={6} radius={5.3} opacity={0.25} />
      <div class="relative flex-1 min-h-0 flex items-center justify-center">
        <!-- MP4 first: it has the page bg (#C8C0B9) baked in, so it looks identical on the flat hero
             and avoids Safari playing the WebM without its alpha channel (black box). -->
        <video
          id="hero-spinner"
          autoplay
          loop
          muted
          playsinline
          class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] max-w-[90vw] max-h-full object-contain opacity-35 pointer-events-none"
          aria-hidden="true"
        >
          <source src="/animations/final-spinner.mp4?v=4" type="video/mp4" />
          <source src="/animations/final%20spinner.webm?v=3" type="video/webm" />
        </video>
        <h1 class="font-display font-normal leading-normal text-[#000] relative z-10 text-center whitespace-nowrap text-[clamp(2.5rem,18vw,16rem)] sm:text-[clamp(2.5rem,12vw,16rem)]">
          Alice Zhou
        </h1>
      </div>
      <div class="relative z-10 flex flex-wrap justify-center gap-3">
        <a href="#work" class="hero-btn hero-btn--primary">VIEW WORK ↓</a>
        <a
          href="https://docs.google.com/document/d/1Z0cEYKNQuoL46fZoC7GOLUCIBl37SCn1xYb6DBa0iRs/edit?usp=sharing"
          target="_blank"
          rel="noopener"
          class="hero-btn hero-btn--secondary"
        >RESUME ↗</a>
      </div>
    </section>
    <script>
      (function () {
        const video = document.getElementById("hero-spinner");
        if (!video) return;
        video.playbackRate = 0.75;
        video.addEventListener("loadedmetadata", function () {
          this.playbackRate = 0.75;
        });
      })();
    </script>

    <div class="bg-dark py-2 px-4 flex-shrink-0">
      <p class="font-accent font-normal leading-normal text-[#FFF] text-center" style="font-size: clamp(1.25rem, 1.69vw, 2.25rem);">
        product designer &amp; front end developer at enlabel global services
      </p>
    </div>
  </div>

  <!-- Work + daily tools -->
  <div class="bg-page">
  <section class="max-w-[1206px] mx-auto px-6 md:px-12 py-16 md:py-24">
    <div id="work" class="flex flex-col gap-7 mb-14 md:mb-20 scroll-mt-8">
      <div class="flex justify-between items-baseline flex-wrap gap-4">
        <h2 class="m-0 font-heading font-medium text-[clamp(32px,3.5vw,44px)]">Work</h2>
        <span class="font-accent text-[22px] text-accent">
          {String(cards.length).padStart(2, "0")} CASE STUDIES
        </span>
      </div>
      {cards.map(({ project, ...card }) => (
        <ProjectCard
          {...card}
          href={`/work/${project.id}`}
          cover={project.data.cover}
          coverAlt={project.data.coverAlt}
        />
      ))}
    </div>

    <h2 class="font-heading text-3xl md:text-4xl text-charcoal-700 mb-6 md:mb-8">
      My Toolbox
    </h2>
    <div
      class="tools-grid grid grid-cols-2 sm:grid-cols-5 gap-4 md:gap-6 auto-rows-fr"
      aria-label="Daily tools"
    >
      {dailyTools.map((tool) => (
        <div
          data-tool={tool.alt}
          class="group rounded-[16px] border border-black/10 bg-taupe-100/60 flex items-center justify-center aspect-square p-5 md:p-6 transition-colors duration-200 hover:bg-taupe-100 hover:border-black/20"
        >
          <img
            src={tool.src}
            alt={tool.alt}
            width="512"
            height="512"
            class="size-32 max-w-full max-h-full object-contain transition-all duration-200 md:grayscale md:opacity-80 md:group-hover:grayscale-0 md:group-hover:opacity-100"
            loading="lazy"
            decoding="async"
          />
        </div>
      ))}
    </div>

    <!-- Pill cursor that follows the pointer over the tools grid -->
    <div
      id="tool-cursor"
      class="fixed left-0 top-0 z-[100] pointer-events-none rounded-full bg-black text-white font-accent text-[16px] leading-none px-3 py-1.5 whitespace-nowrap opacity-0 transition-opacity duration-150"
      aria-hidden="true"
    ></div>
    <script>
      const grid = document.querySelector<HTMLElement>(".tools-grid");
      const pill = document.getElementById("tool-cursor");
      const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");

      if (grid && pill) {
        grid.addEventListener("pointermove", (e) => {
          if (!finePointer.matches) return;
          const tile = (e.target as HTMLElement).closest<HTMLElement>("[data-tool]");
          if (!tile) {
            pill.classList.add("opacity-0");
            return;
          }
          pill.textContent = tile.dataset.tool ?? "";
          pill.style.transform = `translate(${e.clientX}px, ${e.clientY}px) translate(12px, 12px)`;
          pill.classList.remove("opacity-0");
        });

        grid.addEventListener("pointerleave", () => pill.classList.add("opacity-0"));
        window.addEventListener("scroll", () => pill.classList.add("opacity-0"), { passive: true });
      }
    </script>
  </section>
  </div>

</BaseLayout>

<style>
  /* Hero CTAs: fixed height + flex centering, since VT323's metrics sit off-center */
  .hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    padding: 0 22px;
    line-height: 1;
    font-family: var(--font-accent);
    font-size: 24px;
    border-radius: 999px;
    border: 1.5px solid var(--color-dark);
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }
  .hero-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  .hero-btn--primary {
    background: var(--color-dark);
    color: #f5f2ed;
  }
  .hero-btn--primary:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }
  .hero-btn--secondary {
    background: transparent;
    color: var(--color-dark);
  }
  .hero-btn--secondary:hover {
    background: var(--color-dark);
    color: #f5f2ed;
  }

  /* Hide the system cursor over tool tiles so only the pill shows (mouse/trackpad only) */
  @media (hover: hover) and (pointer: fine) {
    .tools-grid [data-tool] {
      cursor: none;
    }
  }
</style>
