---
import { getCollection, render } from "astro:content";
import CaseStudyLayout from "../../layouts/CaseStudyLayout.astro";
import CaseStudyTemplateLayout from "../../layouts/CaseStudyTemplateLayout.astro";
import SkipLegalTestingCard from "../../components/SkipLegalTestingCard.astro";
import SkipLegalTestingRow from "../../components/SkipLegalTestingRow.astro";
import SkipLegalCanvaEmbed from "../../components/SkipLegalCanvaEmbed.astro";
import CsSection from "../../components/case-study/CsSection.astro";
import CsContext from "../../components/case-study/CsContext.astro";
import CsInsights from "../../components/case-study/CsInsights.astro";
import CsInsight from "../../components/case-study/CsInsight.astro";
import CsAnnotated from "../../components/case-study/CsAnnotated.astro";
import CsDecisions from "../../components/case-study/CsDecisions.astro";
import CsDecision from "../../components/case-study/CsDecision.astro";
import CsStates from "../../components/case-study/CsStates.astro";
import CsBeforeAfter from "../../components/case-study/CsBeforeAfter.astro";
import CsImpact from "../../components/case-study/CsImpact.astro";
import CsReflection from "../../components/case-study/CsReflection.astro";
import CsStats from "../../components/case-study/CsStats.astro";
import CsSlideshow from "../../components/case-study/CsSlideshow.astro";

const templateComponents = {
  CsSection,
  CsContext,
  CsStats,
  CsSlideshow,
  CsInsights,
  CsInsight,
  CsAnnotated,
  CsDecisions,
  CsDecision,
  CsStates,
  CsBeforeAfter,
  CsImpact,
  CsReflection,
  SkipLegalCanvaEmbed,
};

export async function getStaticPaths() {
  const entries = await getCollection("work");
  // Prev / next nav order (wraps around)
  const NAV_ORDER = ["eifu-marketing-site", "skiplegal", "haven"];
  const rank = (id: string) => {
    const i = NAV_ORDER.indexOf(id);
    return i === -1 ? NAV_ORDER.length : i;
  };
  const sorted = [...entries].sort((a, b) => rank(a.id) - rank(b.id) || a.data.order - b.data.order);
  const link = (e: (typeof sorted)[number]) => ({ slug: e.id, title: e.data.title });
  return sorted.map((entry, index) => {
    const prev = sorted[(index - 1 + sorted.length) % sorted.length];
    const next = sorted[(index + 1) % sorted.length];
    return {
      params: { slug: entry.id },
      props: { entry, otherProjects: [link(prev), link(next)] },
    };
  });
}

const { entry, otherProjects = [] } = Astro.props;
const { Content } = await render(entry);
---

{entry.data.variant === "template" ? (
<CaseStudyTemplateLayout
  title={entry.data.title}
  eyebrow={entry.data.eyebrow}
  headline={entry.data.headline}
  tags={entry.data.tags}
  tldr={entry.data.tldr}
  tldrResult={entry.data.tldrResult}
  toc={entry.data.toc}
  accent={entry.data.accent}
  prev={otherProjects[0]}
  next={otherProjects[1]}
>
  <Content components={templateComponents} />
</CaseStudyTemplateLayout>
) : (
<CaseStudyLayout
  title={entry.data.title}
  year={entry.data.year}
  role={entry.data.role}
  category={entry.data.category}
  tags={entry.data.tags}
  timeline={entry.data.timeline}
  team={entry.data.team}
  responsibilities={entry.data.responsibilities}
  tools={entry.data.tools}
  results={entry.data.results}
  cover={entry.data.cover}
  coverAlt={entry.data.coverAlt}
  coverFillHeight={true}
  contentMaxWidth={1128}
  headingExpandsRight={entry.id === "eifu-marketing-site"}
  coverAlignBottom={entry.id === "eifu-marketing-site"}
  coverRounded={entry.id !== "eifu-marketing-site"}
  otherProjects={otherProjects}
>
  <Content
    components={entry.id === "eifu-marketing-site"
      ? { SkipLegalTestingCard, SkipLegalTestingRow }
      : undefined}
  />
</CaseStudyLayout>
)}
