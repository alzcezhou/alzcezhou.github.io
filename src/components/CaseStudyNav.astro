---
/** Prev / "All Projects" / next links at the bottom of a case study */
interface Props {
  prev?: { slug: string; title: string };
  next?: { slug: string; title: string };
  class?: string;
}

const { prev, next, class: className } = Astro.props;
---

<nav class:list={["px-6 md:px-16 lg:px-24 pb-24 flex justify-between items-center gap-4", className]}>
  <div class="flex-1 min-w-0 flex justify-start">
    {prev ? (
      <a
        href={`/work/${prev.slug}`}
        class="font-accent text-[24px] text-on-light hover:opacity-80 transition-opacity inline-flex items-center gap-2"
      >
        <span aria-hidden="true">&larr;</span>
        {prev.title}
      </a>
    ) : (
      <span />
    )}
  </div>
  <a
    href="/"
    class="font-accent text-xl text-on-light hover:opacity-80 transition-opacity flex-shrink-0"
  >
    All Projects
  </a>
  <div class="flex-1 min-w-0 flex justify-end">
    {next ? (
      <a
        href={`/work/${next.slug}`}
        class="font-accent text-[24px] text-on-light hover:opacity-80 transition-opacity inline-flex items-center gap-2"
      >
        {next.title}
        <span aria-hidden="true">&rarr;</span>
      </a>
    ) : (
      <span />
    )}
  </div>
</nav>
