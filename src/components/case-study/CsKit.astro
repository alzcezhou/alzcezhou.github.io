---
/** Component kit grid: card tiles of component exports with VT323 captions. `tall` tiles span two rows. */
interface Props {
  tiles: { src: string; alt: string; caption: string; maxWidth?: number; tall?: boolean }[];
}

const { tiles } = Astro.props;
---

<div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,220px),1fr))] gap-4 items-start">
  {tiles.map(({ src, alt, caption, maxWidth, tall }) => (
    <figure class:list={["m-0 bg-card rounded-[14px] p-5 flex flex-col gap-3", tall && "row-span-2"]}>
      <img
        src={src}
        alt={alt}
        class:list={["block w-full", tall && "max-h-[520px] object-contain object-top"]}
        style={maxWidth ? `max-width:${maxWidth}px` : undefined}
        loading="lazy"
        decoding="async"
      />
      <figcaption class="font-accent text-[18px] uppercase">{caption}</figcaption>
    </figure>
  ))}
</div>
