---
/** 01 Context: short intro (slot) beside an image. `well` frames a narrow screenshot in a hero-color well. */
interface Props {
  id: string;
  label: string;
  src: string;
  alt: string;
}

const { id, label, src, alt, well = false } = Astro.props;
---

<section id={id} class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,320px),1fr))] gap-10 items-center scroll-mt-8">
  <div class="flex flex-col gap-4">
    <span class="font-accent text-[22px] text-accent uppercase">{label}</span>
    <div class="flex flex-col gap-4 text-[22px] leading-[1.45] [text-wrap:pretty] [&_p]:m-0">
      <slot />
    </div>
  </div>
  {well ? (
    <div class="bg-light rounded-[14px] p-7 flex justify-center">
      <img src={src} alt={alt} class="block w-full max-w-[340px] rounded-[10px]" loading="lazy" decoding="async" />
    </div>
  ) : (
    <img src={src} alt={alt} class="block w-full rounded-[10px]" loading="lazy" decoding="async" />
  )}
</section>
