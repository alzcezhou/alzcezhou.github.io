---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="flex-[1_1_200px] bg-card p-6 flex flex-col gap-2">
  <h3 class="m-0 font-heading font-normal text-[22px] leading-tight">{title}</h3>
  <div class="text-[15px] leading-[1.5] text-body-2 [&_p]:m-0">
    <slot />
  </div>
</div>
