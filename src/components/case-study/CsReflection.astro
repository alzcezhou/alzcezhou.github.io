---
/** Pull quote plus a short next-steps line */
interface Props {
  quote: string;
  next?: string;
}

const { quote, next } = Astro.props;
---

<blockquote class="m-0 font-heading italic text-[clamp(26px,3vw,34px)] leading-[1.25] max-w-[820px] [text-wrap:balance]">
  {quote}
</blockquote>
{next && <p class="m-0 text-[17px] leading-[1.6] text-body-2 max-w-[640px]">{next}</p>}
