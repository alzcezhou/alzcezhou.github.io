---
interface Props {
  href: string;
  eyebrow: string;
  title: string;
  tags: string[];
  resultNumber: string;
  resultLabel: string;
  cover?: string; // path in public/, e.g. "/images/work/haven-cover.webp"
  coverAlt: string;
}

const { href, eyebrow, title, tags, resultNumber, resultLabel, cover, coverAlt } = Astro.props;
---

<a href={href} class="project-card">
  <div class="flex flex-col gap-[18px]">
    <span class="font-accent text-[20px] tracking-[.04em]">{eyebrow}</span>
    <h3 class="m-0 font-heading font-medium text-[clamp(28px,3vw,40px)] leading-[1.08] tracking-[-.01em] text-balance">
      {title}
    </h3>
    <div class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="font-accent text-[18px] px-3 py-[3px] rounded-full bg-dark text-white">{tag}</span>
      ))}
    </div>
    <div class="flex items-baseline gap-3 flex-wrap pt-[14px] border-t border-dashed border-[rgba(15,15,15,.3)]">
      <span class="font-heading text-[36px] leading-none text-dark">{resultNumber}</span>
      <span class="font-body text-[15px] leading-[1.4]">{resultLabel}</span>
    </div>
    <span class="font-accent text-[20px]">READ CASE STUDY →</span>
  </div>
  <div class="flex items-center justify-center">
    {cover ? (
      <img
        src={cover}
        alt={coverAlt}
        class="block w-full max-h-[380px] object-contain"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <span class="img-placeholder w-full aspect-[4/3] px-4 text-center" aria-hidden="true">{coverAlt}</span>
    )}
  </div>
</a>

<style>
  .project-card {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr));
    gap: 32px;
    align-items: center;
    background: var(--color-bg-light);
    border-radius: 16px;
    padding: clamp(24px, 4vw, 48px);
    color: var(--color-dark);
    transition: transform 0.3s, box-shadow 0.3s;
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px -20px rgba(15, 15, 15, 0.45);
  }

  .project-card:focus-visible {
    outline: 2px solid var(--color-dark);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card:hover {
      transform: none;
    }
  }
</style>
