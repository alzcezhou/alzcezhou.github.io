---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import StaggeredMenu from "../components/StaggeredMenu.jsx";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Portfolio of Alice Zhou — UX Designer" } = Astro.props;

const menuItems = [
  { label: "Home", link: "/" },
  { label: "Work", link: "/#work" },
  { label: "About", link: "/about" },
  { label: "Resume", link: "https://docs.google.com/document/d/1Z0cEYKNQuoL46fZoC7GOLUCIBl37SCn1xYb6DBa0iRs/edit?usp=sharing" },
  { label: "Contact", link: "/about#contact" },
];

const socialItems = [
  { label: "Email", link: "mailto:alzce03@gmail.com" },
  { label: "LinkedIn", link: "https://www.linkedin.com/in/alzce/" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=Inter:wght@400;600;700&family=Jacquard+24&family=VT323&family=Vollkorn:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&display=swap"
      rel="stylesheet"
    />
    <script src="https://unpkg.com/@lottiefiles/dotlottie-wc@0.9.3/dist/dotlottie-wc.js" type="module"></script>
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-charcoal-700 focus:text-taupe-100 focus:px-4 focus:py-2 focus:rounded-lg">
      Skip to content
    </a>
    <StaggeredMenu
      client:load
      items={menuItems}
      socialItems={socialItems}
      showLogo={false}
      position="right"
      isFixed={true}
      closeOnClickAway={true}
      menuButtonColor="#0F0F0F"
      openMenuButtonColor="#ffffff"
      accentColor="#5C544A"
      colors={["#F0EBE4", "#C4B5A4"]}
    />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      // Any email link copies the address instead of opening a mail client.
      document.addEventListener("click", async (e) => {
        const link = (e.target as Element).closest?.('a[href^="mailto:"]') as HTMLAnchorElement | null;
        if (!link) return;
        e.preventDefault();
        const email = link.href.replace(/^mailto:/, "").split("?")[0];
        try {
          await navigator.clipboard.writeText(email);
        } catch {
          window.location.href = link.href;
          return;
        }
        if (!link.dataset.label) link.dataset.label = link.textContent ?? "";
        link.textContent = "copied!";
        clearTimeout(Number(link.dataset.timer));
        link.dataset.timer = String(
          setTimeout(() => {
            link.textContent = link.dataset.label!;
            delete link.dataset.label;
          }, 1000)
        );
      });
    </script>
  </body>
</html>
